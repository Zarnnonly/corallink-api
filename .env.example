# Koneksi Database (sesuaikan dengan Laragon kamu)
# Default Laragon: user "root", password kosong
DATABASE_URL="mysql://root:@localhost:3306/corallink_db"

# JWT
JWT_SECRET="ganti_dengan_string_random_yang_susah_ditebak"
JWT_EXPIRES_IN="1d"

# Server
PORT=3000

# AI Model Service (Flask/FastAPI temanmu, atau dummy dulu kalau belum siap)
AI_SERVICE_URL="http://localhost:5000/predict"
USE_DUMMY_AI=true
